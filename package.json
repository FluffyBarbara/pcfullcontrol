{
  "name": "pc-full-control",
  "productName": "PC Full Control",
  "version": "1.12.5",
  "description": "Управление компьютером с телефона через Telegram",
  "main": "src/main/main.js",
  "author": "PC Full Control",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "electron-updater": "6.8.11",
    "qrcode": "1.5.4",
    "sql.js": "1.15.2",
    "systeminformation": "5.33.19"
  },
  "devDependencies": {
    "electron": "44.10.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.pcfullcontrol.app",
    "productName": "PC Full Control",
    "executableName": "PCFullControl",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/@huggingface/transformers/dist/*.web*",
      "!node_modules/@huggingface/transformers/dist/transformers.js",
      "!node_modules/@huggingface/transformers/dist/transformers.min.js",
      "!node_modules/@huggingface/transformers/dist/ort-*",
      "!node_modules/**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "PC Full Control",
      "include": "build/installer.nsh",
      "artifactName": "PCFullControl-Setup.exe",
      "language": "1049"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FluffyBarbara",
        "repo": "pcfullcontrol",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/@huggingface/**"
    ],
    "extraResources": [
      {
        "from": "build/bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      }
    ]
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "^11.0.1"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    }
  }
}
